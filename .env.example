# 复制这份文件为 .env（仅本地调试用），正式部署时在 Vercel 控制台填这些变量。
# 注意：千万别把填好真实值的 .env 提交到 GitHub！
#
# 管理 bot 的 Token（@BotFather 创建 bot 后给你的那串 数字:字母）
MANAGER_BOT_TOKEN=
# 平台管理员的 Telegram 数字 ID，多个用英文逗号隔开（@userinfobot 可查）
PLATFORM_ADMIN_IDS=
# 自定义一串 20 位以上的随机字符，保护 /api/setupmanager 激活接口
SETUP_SECRET=
# Upstash Redis 的 REST 连接信息（Upstash 控制台 → 数据库详情 → REST API）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# （二选一）用 Vercel 的 Upstash 集成时，自动生成的变量名是下面这两个，代码也认：
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Cloudflare Turnstile 密钥（可选，不配则网页验证不可用，自动走答题验证）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 自定义 Telegram API 地址（可选，高级用户用，默认 https://api.telegram.org）
# API_BASE=
